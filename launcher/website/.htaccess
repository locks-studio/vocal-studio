# Hostinger : page d'accueil, page 404, cache et compression du site 1999
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes
AddType video/webm .webm
AddType image/webp .webp
# Fichiers à télécharger : le bon type, et toujours un téléchargement (jamais affichés dans le navigateur)
AddType application/x-apple-diskimage .dmg
AddType application/gzip .gz
<FilesMatch "\.(dmg|exe|zip|gz)$">
  <IfModule mod_headers.c>
    Header set Content-Disposition "attachment"
  </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  # Le launcher et le site doivent toujours voir le catalogue et la page à jour
  <FilesMatch "\.(json|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|png|webp|webm)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
