{
  "name": "launcher-1999",
  "productName": "1999",
  "version": "0.5.2",
  "description": "Le launcher de Locks : installe, met à jour et lance Hush et les prochains logiciels",
  "main": "src/main.js",
  "private": true,
  "author": "Locks",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:linux": "electron-builder --linux dir --x64 && python tools/pack-linux.py",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64",
    "publier": "node tools/publish-ftp.js",
    "publier:test": "node tools/publish-ftp.js --test"
  },
  "build": {
    "appId": "fr.locks.launcher1999",
    "productName": "1999",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "config.json",
      "build/icon.png",
      "package.json"
    ],
    "artifactName": "1999-Setup-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "license": "build/conditions.txt",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "1999",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "1999",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "executableName": "launcher-1999"
    },
    "afterPack": "../tools/mac-adhoc-sign.js"
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
