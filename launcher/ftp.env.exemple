# Copie ce fichier en « ftp.env » (même dossier) et remplis les 3 lignes avec les infos de hPanel › Fichiers › Comptes FTP.
# ftp.env reste sur ce PC : il n'est jamais envoyé sur GitHub.
FTP_HOST=
FTP_USER=
FTP_PASS=
# Facultatif : le dossier du site vu par ce compte FTP (sinon il est trouvé tout seul). Ex. : public_html/1999
FTP_DIR=
