{
  "name": "vocal-studio",
  "productName": "Hush",
  "version": "0.3.0",
  "description": "Interface d'appel vocal Discord personnalisable",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win zip --x64",
    "dist:linux": "electron-builder --linux zip --x64",
    "dist:mac": "electron-builder --mac zip --x64 --arm64"
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "music-metadata": "^7.14.0",
    "ws": "^8.22.0"
  },
  "author": "Locks",
  "build": {
    "appId": "fr.locks.hush",
    "productName": "Hush",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "build/icon.png"
    ],
    "artifactName": "Hush-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "build/icon.png"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "identity": "-"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network",
      "executableName": "hush"
    },
    "asarUnpack": [
      "src/media.ps1"
    ]
  }
}
