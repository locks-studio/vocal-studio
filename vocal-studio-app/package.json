{
  "name": "vocal-studio",
  "productName": "Hush",
  "version": "0.6.4",
  "description": "Interface d'appel vocal Discord personnalisable",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win zip --x64",
    "dist:linux": "electron-builder --linux zip --x64",
    "dist:mac": "electron-builder --mac zip --x64 --arm64",
    "dist:preview": "node tools/build-preview.js"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "music-metadata": "^12.5.0",
    "ws": "^8.22.0"
  },
  "author": "Locks",
  "build": {
    "appId": "fr.locks.hush",
    "productName": "Hush",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json",
      "build/icon.png",
      "build/icon-preview.png"
    ],
    "artifactName": "Hush-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "build/icon.png"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Hush utilise le micro seulement quand tu enregistres un son.",
        "NSCameraUsageDescription": "Hush affiche ta caméra seulement si tu l'allumes dans Hush.",
        "NSAppleEventsUsageDescription": "Hush lit le titre en cours dans Spotify ou Musique pour l'afficher (source « Ce PC »)."
      }
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network",
      "executableName": "hush"
    },
    "asarUnpack": [
      "src/media.ps1",
      "src/layer-overlay.py"
    ],
    "afterPack": "../tools/after-pack.js"
  }
}
