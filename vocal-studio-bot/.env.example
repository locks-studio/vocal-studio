# Copie ce fichier en « .env » et remplis-le (ne le partage jamais : il contient des secrets).

# Portail développeur Discord > ton application > Bot > Reset Token
DISCORD_TOKEN=

# Portail développeur Discord > ton application > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Adresse publique du serveur. En local : http://localhost:8787
# Ajoute « <PUBLIC_URL>/auth/callback » dans OAuth2 > Redirects sur le portail.
PUBLIC_URL=http://localhost:8787
PORT=8787

# Vue administrateur dans Hush : le propriétaire de l'application Discord y a droit tout seul.
# Pour l'ouvrir à d'autres comptes, mets ici leurs identifiants Discord séparés par des virgules.
ADMIN_IDS=
